# --- LLM (vía CLI de Claude Code, sin API key; usa la sesión de `claude`) ---
LLM_MODEL=claude-haiku-5-5
CLAUDE_CLI_PATH=claude       # ejecutable del CLI
LLM_TIMEOUT_S=120            # tiempo máximo por llamada al LLM
MAX_AGENT_ITERATIONS=8
MEMORY_MAX_TOKENS=8000       # estimación (caracteres/4) a partir de la cual se resumen los turnos antiguos
MEMORY_KEEP_TURNS=3          # turnos recientes que se conservan íntegros

# --- RAG ---
VECTOR_STORE=json            # json | chroma (al cambiar hay que reindexar con /ingestar)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=700               # caracteres aproximados
CHUNK_OVERLAP=100
TOP_K_DEFAULT=5
MIN_SCORE=0.25
SEARCH_MODE=hybrid           # hybrid (vector + BM25, por defecto) | vector (solo significado) | lexical (solo BM25, para comparar)
LEXICAL_RESERVE=3            # mejores resultados BM25 que siempre entran en el top-k de hybrid (0 = RRF pura)
LEXICAL_MIN=4.0              # BM25 mínimo para admitir un fragmento aunque su coseno no llegue a MIN_SCORE (solo hybrid/lexical)

# --- Mermaid (opcional) ---
MERMAID_VALIDATE=heuristic   # heuristic | cli (valida con mermaid-cli si está instalado en tools/mermaid; si no, cae a la heurística)
MERMAID_CLI_PATH=./tools/mermaid/node_modules/.bin/mmdc
MERMAID_TIMEOUT_S=30
MERMAID_PUPPETEER_CONFIG=    # si Chromium falla con "No usable sandbox" (Ubuntu 23.10+): ./tools/mermaid/puppeteer-config.json (--no-sandbox)

# --- Rutas ---
DATA_DIR=./data
OUTPUTS_DIR=./outputs
LOGS_DIR=./logs
SKILLS_DIR=./skills
ACTIVE_SKILL=documentacion-tecnica

# --- Seguridad / límites ---
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.md,.txt,.pdf,.py,.js,.ts,.java,.json,.yaml,.yml
ALLOWED_INGEST_DIR=./data/documents

# --- Evaluaciones ---
EVAL_MIN_PASS=0.8
