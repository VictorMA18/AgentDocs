# --- LLM (vía CLI de Claude Code, sin API key; usa la sesión de `claude`) ---
LLM_MODEL=claude-haiku-5-5
CLAUDE_CLI_PATH=claude       # ejecutable del CLI
LLM_TIMEOUT_S=120            # tiempo máximo por llamada al LLM
MAX_AGENT_ITERATIONS=8

# --- RAG ---
VECTOR_STORE=json            # json | chroma
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=700               # caracteres aproximados
CHUNK_OVERLAP=100
TOP_K_DEFAULT=5
MIN_SCORE=0.25

# --- Rutas ---
DATA_DIR=./data
OUTPUTS_DIR=./outputs
LOGS_DIR=./logs
SKILLS_DIR=./skills
ACTIVE_SKILL=documentacion-tecnica

# --- Seguridad / límites ---
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.md,.txt,.pdf,.py,.js,.ts,.java,.json,.yaml,.yml
ALLOWED_INGEST_DIR=./data/documents

# --- Evaluaciones ---
EVAL_MIN_PASS=0.8
